{
  "name": "linux_turbo_ht",
  "title": "Linux only - Turbo Boost x Hyper-threading (paper Table III)",
  "description": "EXAMPLE, not run on macOS. pre_cmd toggles Intel Turbo Boost and SMT before every run (needs root: run the harness with sudo or grant write access to these sysfs files). Rounds stay randomized because the toggle happens per run.",
  "urls": "data/urls.txt",
  "server": {
    "start": false,
    "host": "192.168.1.2",
    "port": 80
  },
  "reps": 60,
  "warmup": 3,
  "variants": [
    {
      "name": "stable-O3",
      "toolchain": "stable",
      "opt_level": 3
    }
  ],
  "configs": [
    {
      "name": "process-noTB-noHT",
      "variant": "stable-O3",
      "mode": "process",
      "args": {
        "workers": 16
      },
      "pre_cmd": "echo 1 > /sys/devices/system/cpu/intel_pstate/no_turbo && echo off > /sys/devices/system/cpu/smt/control && sleep 1"
    },
    {
      "name": "process-noTB-HT",
      "variant": "stable-O3",
      "mode": "process",
      "args": {
        "workers": 16
      },
